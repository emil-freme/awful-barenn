#!/usr/bin/env bash
# evaluate - compile a source file at every optimization level, run each
# binary, and write the results to a Markdown report.
#
# Usage: evaluate <source.cpp> <report.md> [-omp|-cuda] [-callgrind] [-nsys]
#
#   (no flag)  g++  -std=c++17
#   -omp       g++  -std=c++17 -fopenmp
#   -cuda      nvcc -std=c++17   (adds "-x cu" when the file is not .cu)
#
#   -callgrind also profiles every level with Valgrind's callgrind tool and
#              adds the instruction counts and hottest functions to the
#              report. Each level is rebuilt with the same flags plus -g for
#              this, so the timed binaries are not affected. The raw profiles
#              are kept in <report>-callgrind/ (report name without .md) for
#              callgrind_annotate or kcachegrind. Callgrind is often 50-100x
#              slower than a normal run, so expect this to take a while.
#   -nsys      also profiles every level's timed binary with NVIDIA Nsight
#              Systems and adds its summaries to the report: GPU kernels, GPU
#              memory operations and CUDA API calls, OpenMP events, NVTX
#              ranges and OS runtime calls (each one only when it recorded
#              data). The .nsys-rep files are kept in <report>-nsys/ for
#              nsys-ui. Works in every mode and together with -callgrind.
#
# Flags may come in any order after the two file names.
#
# Levels: none, -O1, -O2, -O3, -Ofast. nvcc has no -Ofast, so the CUDA
# "-Ofast" level is "-use_fast_math -Xcompiler -Ofast" (device code is still
# built at ptxas -O3, its default).
#
# Each binary runs with no arguments from the current directory, so call this
# from the folder that holds the input data. The report is overwritten.
#
# Optional environment overrides (grep -P patterns, \K marks the match start):
#   EVAL_TIME_REGEX    time printed by the program
#                      default: 'Tempo de treino \K[0-9.]+'
#   EVAL_ACC_REGEX     accuracy printed by the program
#                      default: 'Acuracia \K[0-9.]+%'
#   EVAL_IGNORE_REGEX  lines skipped when comparing outputs with the baseline
#                      default: '[Tt]empo|[Tt]ime'
#
# With -callgrind:
#   EVAL_CALLGRIND_ARGS  arguments given to the program only when it runs
#                        under callgrind, e.g. a smaller training file to
#                        shorten profiling. default: none (same as timed run)
#   EVAL_CALLGRIND_TOP   functions listed per level. default: 10
#
# With -nsys:
#   EVAL_NSYS_TRACE  APIs traced (nsys profile --trace). default:
#                    cuda,nvtx,osrt with -cuda, openmp,nvtx,osrt with -omp,
#                    nvtx,osrt otherwise
#   EVAL_NSYS_TOP    rows listed per summary table. default: 10

set -uo pipefail
# Keep "." as the decimal separator regardless of the user's locale.
export LC_ALL=C

usage() {
    echo "Usage: $(basename "$0") <source.cpp> <report.md> [-omp|-cuda] [-callgrind] [-nsys]" >&2
    exit 2
}

(( $# >= 2 )) || usage
src=$1
report=$2
shift 2
mode=""
callgrind=0
nsys=0
for flag in "$@"; do
    case $flag in
        -omp | -cuda)
            [[ -z $mode ]] || { echo "Use only one of -omp and -cuda." >&2; usage; }
            mode=$flag
            ;;
        -callgrind) callgrind=1 ;;
        -nsys) nsys=1 ;;
        *) echo "Unknown flag '$flag' (expected -omp, -cuda, -callgrind or -nsys)." >&2; usage ;;
    esac
done
[[ -f $src ]] || { echo "Source file not found: $src" >&2; exit 1; }

default_time_re='Tempo de treino \K[0-9.]+'
default_acc_re='Acuracia \K[0-9.]+%'
default_ignore_re='[Tt]empo|[Tt]ime'
time_re=${EVAL_TIME_REGEX:-$default_time_re}
acc_re=${EVAL_ACC_REGEX:-$default_acc_re}
ignore_re=${EVAL_IGNORE_REGEX:-$default_ignore_re}

labels=(none -O1 -O2 -O3 -Ofast)
case $mode in
    -cuda)
        compiler=nvcc
        base_flags=(-std=c++17)
        [[ $src == *.cu ]] || base_flags+=(-x cu)
        # No -O3 here: nvcc would append it after -Ofast and override it.
        levels=("" "-O1" "-O2" "-O3" "-use_fast_math -Xcompiler -Ofast")
        mode_desc="CUDA (nvcc)"
        ;;
    -omp)
        compiler=g++
        base_flags=(-std=c++17 -fopenmp)
        levels=("" "-O1" "-O2" "-O3" "-Ofast")
        mode_desc="OpenMP (g++ -fopenmp)"
        ;;
    *)
        compiler=g++
        base_flags=(-std=c++17)
        levels=("" "-O1" "-O2" "-O3" "-Ofast")
        mode_desc="Serial (g++)"
        ;;
esac
command -v "$compiler" >/dev/null || { echo "$compiler not found in PATH." >&2; exit 1; }

if (( callgrind )); then
    for tool in valgrind callgrind_annotate; do
        command -v "$tool" >/dev/null || { echo "$tool not found in PATH (needed by -callgrind)." >&2; exit 1; }
    done
    cg_top=${EVAL_CALLGRIND_TOP:-10}
    [[ $cg_top =~ ^[1-9][0-9]*$ ]] || { echo "EVAL_CALLGRIND_TOP must be a positive integer." >&2; exit 2; }
    cg_args_str=${EVAL_CALLGRIND_ARGS:-}
    read -ra cg_args <<< "$cg_args_str"
    # Raw profiles go next to the report so they survive the temp dir cleanup.
    cg_dir="${report%.md}-callgrind"
    mkdir -p "$cg_dir" || exit 1
    cg_rel=$(basename "$cg_dir")
    echo "Callgrind enabled: every level is also profiled, which takes far longer than the timed runs." >&2
fi

if (( nsys )); then
    command -v nsys >/dev/null || { echo "nsys not found in PATH (needed by -nsys)." >&2; exit 1; }
    ns_top=${EVAL_NSYS_TOP:-10}
    [[ $ns_top =~ ^[1-9][0-9]*$ ]] || { echo "EVAL_NSYS_TOP must be a positive integer." >&2; exit 2; }
    case $mode in
        -cuda) ns_default_trace=cuda,nvtx,osrt ;;
        -omp)  ns_default_trace=openmp,nvtx,osrt ;;
        *)     ns_default_trace=nvtx,osrt ;;
    esac
    ns_trace=${EVAL_NSYS_TRACE:-$ns_default_trace}
    # Every summary is requested in every mode; the ones without data come
    # out empty and are left out of the report.
    ns_reports=(cuda_gpu_kern_sum cuda_gpu_mem_time_sum cuda_api_sum openmp_sum nvtx_sum osrt_sum)
    ns_report_list=$(IFS=,; echo "${ns_reports[*]}")
    ns_dir="${report%.md}-nsys"
    mkdir -p "$ns_dir" || exit 1
    ns_rel=$(basename "$ns_dir")
    ns_cpu_off=0
fi

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

now() { date +%s.%N; }
seconds_between() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.3f", b - a }'; }
ratio() { awk -v a="$1" -v b="$2" 'BEGIN { if (b > 0) printf "%.2fx", a / b; else print "n/a" }'; }
# 1234567 -> 1,234,567 (empty stays empty).
commas() {
    awk -v n="$1" 'BEGIN {
        s = ""
        while (length(n) > 3) { s = "," substr(n, length(n) - 2) s; n = substr(n, 1, length(n) - 3) }
        print n s
    }'
}

# Prints a Markdown table of the functions with the highest self cost in a
# callgrind profile, next to their inclusive cost (self plus everything they
# call). Parses callgrind_annotate lines of the form
# "1,234 (12.34%)  file:function [object]"; awk here may be mawk, so no gawk-only features.
cg_hotspots() {
    awk -v top="$cg_top" '
        function parse(line) {
            if (line !~ /^ *[0-9][0-9,]* \( *[0-9.]+%\) /) return 0
            sub(/^ +/, "", line)
            ir = line;   sub(/ .*/, "", ir)
            pct = line;  sub(/^[^(]*\( */, "", pct); sub(/%\).*/, "", pct)
            name = line; sub(/^[^)]*\) +/, "", name); sub(/ \[[^[]*\]$/, "", name)
            return name != "PROGRAM TOTALS"
        }
        # First input: inclusive costs, kept for lookup.
        FNR == NR { if (parse($0)) incl[name] = pct; next }
        # Second input: self costs, already sorted from highest to lowest.
        parse($0) && shown < top {
            shown++
            file = ""; fn = name
            if (index(name, ":") > 0) {
                file = name; sub(/:.*/, "", file)
                fn = substr(name, length(file) + 2)
                sub(/.*\//, "", file)
            }
            gsub(/\|/, "\\|", fn)
            if (shown == 1) {
                print "| # | Function | File | Self Ir | Self % | Inclusive % |"
                print "|---:|---|---|---:|---:|---:|"
            }
            printf "| %d | `%s` | %s | %s | %s%% | %s |\n", shown, fn,
                (file == "" ? "n/a" : file), ir, pct, (name in incl ? incl[name] "%" : "n/a")
        }
    ' <(callgrind_annotate --inclusive=yes --auto=no --threshold=100 "$1" 2>/dev/null) \
      <(callgrind_annotate --auto=no --threshold=100 "$1" 2>/dev/null)
}

# Sums the column named $2 of an nsys stats TSV file; prints nothing when the
# file is empty or has no such column.
tsv_sum() {
    [[ -s $1 ]] || return 0
    awk -F'\t' -v name="$2" '
        NR == 1 { for (c = 1; c <= NF; c++) if ($c == name) col = c; next }
        col && NF { s += $col; n++ }
        END { if (col && n) printf "%.0f", s }
    ' "$1"
}
ns_to_ms() { [[ -n $1 ]] && awk -v n="$1" 'BEGIN { printf "%.3f", n / 1e6 }'; }

ns_title() {
    case $1 in
        cuda_gpu_kern_sum)     echo "GPU kernels" ;;
        cuda_gpu_mem_time_sum) echo "GPU memory operations" ;;
        cuda_api_sum)          echo "CUDA API calls (CPU side)" ;;
        openmp_sum)            echo "OpenMP events" ;;
        nvtx_sum)              echo "NVTX ranges" ;;
        osrt_sum)              echo "OS runtime calls" ;;
        *)                     echo "$1" ;;
    esac
}

# Turns one nsys stats TSV file into a Markdown table of its first
# $ns_top rows. Columns are found by header name, since the reports differ
# (Instances / Num Calls / Count; the name is always the last column).
ns_table() {
    awk -F'\t' -v top="$ns_top" '
        function scaled(c, div, digits) { return c ? sprintf("%." digits "f", $c / div) : "n/a" }
        NR == 1 {
            for (c = 1; c <= NF; c++) {
                if ($c == "Time (%)") pc = c
                else if ($c == "Total Time (ns)") tc = c
                else if ($c == "Instances" || $c == "Num Calls" || $c == "Count") cc = c
                else if ($c == "Avg (ns)") ac = c
            }
            nc = NF
            print "| Time (%) | Total (ms) | Count | Avg (µs) | Name |"
            print "|---:|---:|---:|---:|---|"
            next
        }
        NF == 0 { next }
        { rows++ }
        rows <= top {
            name = $nc; gsub(/\|/, "\\|", name)
            printf "| %s | %s | %s | %s | `%s` |\n", (pc ? $pc : "n/a"), scaled(tc, 1e6, 3),
                (cc ? $cc : "n/a"), scaled(ac, 1e3, 1), name
        }
        END { if (rows > top) printf "\n%d more rows in the .nsys-rep file.\n", rows - top }
    ' "$1"
}

# All non-empty summaries of one nsys stats run, as titled Markdown tables.
ns_summaries() {
    local base=$1 r f first=1
    for r in "${ns_reports[@]}"; do
        f="${base}_$r.tsv"
        [[ -s $f ]] || continue
        (( first )) || echo
        first=0
        echo "**$(ns_title "$r")** (\`$r\`):"
        echo
        ns_table "$f"
    done
}

started_at=$(date '+%Y-%m-%d %H:%M:%S %Z')
bin_name=$(basename "${src%.*}")
total=${#labels[@]}

declare -a shown_cmd compile_log compile_rc compile_time
declare -a run_out run_rc wall_time rep_time accuracy normalized
# cg_status: "skipped" (no -callgrind or compile failed), "build failed" or "ran".
declare -a cg_status cg_cmd cg_file cg_rc cg_time cg_ir cg_table cg_log
# ns_status: "skipped" (no -nsys or compile failed) or "ran".
declare -a ns_status ns_file ns_rc ns_time ns_log ns_detail ns_kern_ms ns_kern_n ns_mem_ms ns_api_ms

for i in "${!labels[@]}"; do
    read -ra opt <<< "${levels[i]}"
    bin="$workdir/bin_$i"
    shown_cmd[i]="$compiler ${base_flags[*]}${levels[i]:+ ${levels[i]}} $src -o $bin_name"

    cg_status[i]="skipped"; cg_cmd[i]=""; cg_file[i]=""; cg_rc[i]=""; cg_time[i]=""
    cg_ir[i]=""; cg_table[i]=""; cg_log[i]=""
    ns_status[i]="skipped"; ns_file[i]=""; ns_rc[i]=""; ns_time[i]=""; ns_log[i]=""; ns_detail[i]=""
    ns_kern_ms[i]=""; ns_kern_n[i]=""; ns_mem_ms[i]=""; ns_api_ms[i]=""

    printf '[%d/%d] %-6s compiling...' "$((i + 1))" "$total" "${labels[i]}" >&2
    t0=$(now)
    compile_log[i]=$("$compiler" "${base_flags[@]}" "${opt[@]}" "$src" -o "$bin" 2>&1)
    compile_rc[i]=$?
    t1=$(now)
    compile_time[i]=$(seconds_between "$t0" "$t1")

    if (( compile_rc[i] != 0 )); then
        echo " FAILED (exit ${compile_rc[i]})" >&2
        run_rc[i]=""; run_out[i]=""; wall_time[i]=""; rep_time[i]=""; accuracy[i]=""; normalized[i]=""
        continue
    fi

    printf ' running...' >&2
    t0=$(now)
    run_out[i]=$("$bin" 2>&1)
    run_rc[i]=$?
    t1=$(now)
    wall_time[i]=$(seconds_between "$t0" "$t1")
    rep_time[i]=$(grep -oP -m1 -- "$time_re" <<< "${run_out[i]}" || true)
    accuracy[i]=$(grep -oP -m1 -- "$acc_re" <<< "${run_out[i]}" || true)
    normalized[i]=$(grep -vE -- "$ignore_re" <<< "${run_out[i]}" || true)

    if (( run_rc[i] == 0 )); then
        echo " done in ${wall_time[i]} s" >&2
    else
        echo " exited with code ${run_rc[i]} after ${wall_time[i]} s" >&2
    fi

    if (( callgrind )); then
        printf '[%d/%d] %-6s profiling with callgrind...' "$((i + 1))" "$total" "${labels[i]}" >&2
        cg_cmd[i]="$compiler ${base_flags[*]}${levels[i]:+ ${levels[i]}} -g $src -o $bin_name"
        cg_file[i]="$cg_dir/callgrind.out.${labels[i]#-}"
        rm -f "${cg_file[i]}"
        # Its own build with -g, so the profile can name source files and
        # lines. -g adds debug info only; the generated code is the same.
        mkdir -p "$workdir/cg_$i"
        cg_bin="$workdir/cg_$i/$bin_name"
        if ! "$compiler" "${base_flags[@]}" "${opt[@]}" -g "$src" -o "$cg_bin" >/dev/null 2>&1; then
            cg_status[i]="build failed"
            echo " FAILED (build with -g)" >&2
        else
            cg_status[i]="ran"
            t0=$(now)
            valgrind --tool=callgrind --callgrind-out-file="${cg_file[i]}" \
                "$cg_bin" ${cg_args[@]+"${cg_args[@]}"} >/dev/null 2>"$workdir/cg_$i/log"
            cg_rc[i]=$?
            t1=$(now)
            cg_time[i]=$(seconds_between "$t0" "$t1")
            cg_log[i]=$(tail -n 20 "$workdir/cg_$i/log")
            if [[ -f ${cg_file[i]} ]]; then
                cg_ir[i]=$(sed -n 's/^\(totals\|summary\): *\([0-9][0-9]*\).*/\2/p' "${cg_file[i]}" | head -1)
                cg_table[i]=$(cg_hotspots "${cg_file[i]}")
            fi
            if (( cg_rc[i] == 0 )); then
                echo " done in ${cg_time[i]} s" >&2
            else
                echo " exited with code ${cg_rc[i]} after ${cg_time[i]} s" >&2
            fi
        fi
    fi

    if (( nsys )); then
        printf '[%d/%d] %-6s profiling with nsys...' "$((i + 1))" "$total" "${labels[i]}" >&2
        ns_status[i]="ran"
        ns_file[i]="$ns_dir/${labels[i]#-}.nsys-rep"
        rm -f "${ns_file[i]}"
        ns_tmp="$workdir/ns_$i"
        mkdir -p "$ns_tmp"
        # Profiles the timed binary itself. CPU sampling stays at the nsys
        # default, which nsys turns off on its own when the system forbids it.
        t0=$(now)
        nsys profile --trace="$ns_trace" --force-overwrite=true \
            --output="${ns_file[i]%.nsys-rep}" "$bin" >"$ns_tmp/log" 2>&1
        ns_rc[i]=$?
        t1=$(now)
        ns_time[i]=$(seconds_between "$t0" "$t1")
        grep -q "does not allow enabling CPU profiling" "$ns_tmp/log" && ns_cpu_off=1
        if [[ -f ${ns_file[i]} ]]; then
            # The SQLite export stays in the temp dir; only .nsys-rep is kept.
            nsys stats --quiet --report "$ns_report_list" --format tsv --output "$ns_tmp/stats" \
                --sqlite "$ns_tmp/report.sqlite" "${ns_file[i]}" >>"$ns_tmp/log" 2>&1
            ns_kern_ms[i]=$(ns_to_ms "$(tsv_sum "$ns_tmp/stats_cuda_gpu_kern_sum.tsv" "Total Time (ns)")")
            ns_kern_n[i]=$(tsv_sum "$ns_tmp/stats_cuda_gpu_kern_sum.tsv" "Instances")
            ns_mem_ms[i]=$(ns_to_ms "$(tsv_sum "$ns_tmp/stats_cuda_gpu_mem_time_sum.tsv" "Total Time (ns)")")
            ns_api_ms[i]=$(ns_to_ms "$(tsv_sum "$ns_tmp/stats_cuda_api_sum.tsv" "Total Time (ns)")")
            ns_detail[i]=$(ns_summaries "$ns_tmp/stats")
        fi
        # Drop the progress-bar lines nsys redraws with carriage returns.
        ns_log[i]=$(tr '\r' '\n' < "$ns_tmp/log" | grep -v -e '^\[[0-9]*/[0-9]*\]' -e '^[[:space:]]*$' | tail -n 20)
        if (( ns_rc[i] == 0 )); then
            echo " done in ${ns_time[i]} s" >&2
        else
            echo " exited with code ${ns_rc[i]} after ${ns_time[i]} s" >&2
        fi
    fi
done

# Speedup uses the program's own time when the baseline printed one,
# otherwise the wall-clock time measured here.
if [[ -n ${rep_time[0]} ]]; then
    speed_basis="program-reported time"
    speed_src=rep_time
else
    speed_basis="wall-clock time"
    speed_src=wall_time
fi
declare -n speed_ref=$speed_src

cell() { [[ -n $1 ]] && printf '%s' "$1" || printf 'n/a'; }

compiler_version() {
    if [[ $compiler == nvcc ]]; then
        printf '%s; host: %s' "$(nvcc --version | grep -m1 release)" "$(g++ --version | head -1)"
    else
        "$compiler" --version | head -1
    fi
}

{
    echo "# Optimization flag evaluation: \`$(basename "$src")\`"
    echo
    echo "| | |"
    echo "|---|---|"
    echo "| **File** | \`$src\` |"
    echo "| **Date/time** | $started_at |"
    echo "| **Mode** | $mode_desc |"
    echo "| **Compiler** | $(compiler_version) |"
    echo "| **CPU** | $(lscpu | sed -n 's/^Model name: *//p' | head -1) ($(nproc) logical cores) |"
    if [[ $mode == -omp ]]; then
        echo "| **OMP_NUM_THREADS** | ${OMP_NUM_THREADS:-unset (runtime default)} |"
    fi
    if [[ $mode == -cuda ]]; then
        # nvidia-smi prints its errors to stdout, so trust it only on success.
        gpu=$(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null) || gpu=""
        gpu=${gpu%%$'\n'*}
        echo "| **GPU** | ${gpu:-not detected (no NVIDIA driver)} |"
    fi
    echo "| **OS** | $(uname -sr) |"
    echo "| **Git revision** | $(git -C "$(dirname "$src")" describe --tags --always --dirty 2>/dev/null || echo n/a) |"
    echo "| **Working directory** | \`$PWD\` |"
    echo
    echo "## Summary"
    echo
    echo "| Level | Flags | Compile | Compile time (s) | Run exit | Wall time (s) | Reported time (s) | Accuracy | Speedup vs none | Same output as none |"
    echo "|---|---|---|---:|---:|---:|---:|---:|---:|---|"
    for i in "${!labels[@]}"; do
        if (( compile_rc[i] != 0 )); then
            echo "| ${labels[i]} | \`${levels[i]:-(none)}\` | failed | ${compile_time[i]} | n/a | n/a | n/a | n/a | n/a | n/a |"
            continue
        fi
        speedup="n/a"
        if [[ -n ${speed_ref[0]} && -n ${speed_ref[i]} ]]; then
            speedup=$(ratio "${speed_ref[0]}" "${speed_ref[i]}")
        fi
        same="n/a"
        if (( i == 0 )); then
            same="baseline"
        elif [[ ${compile_rc[0]} -eq 0 && ${run_rc[0]} -eq 0 && ${run_rc[i]} -eq 0 ]]; then
            [[ ${normalized[i]} == "${normalized[0]}" ]] && same="yes" || same="**no**"
        fi
        echo "| ${labels[i]} | \`${levels[i]:-(none)}\` | ok | ${compile_time[i]} | ${run_rc[i]} | ${wall_time[i]} | $(cell "${rep_time[i]}") | $(cell "${accuracy[i]}") | $speedup | $same |"
    done
    echo
    echo "- Wall time covers the whole run (data loading included). Reported time is what the program prints."
    echo "- Speedup is relative to the \`none\` level and based on $speed_basis."
    echo "- \"Same output as none\" compares the full output, skipping lines that match \`$ignore_re\`."
    if (( callgrind )); then
        echo
        echo "## Callgrind profile"
        echo
        echo "| Level | Profile exit | Profile time (s) | Instructions (Ir) | Ir vs none | Raw profile |"
        echo "|---|---:|---:|---:|---:|---|"
        for i in "${!labels[@]}"; do
            case ${cg_status[i]} in
                skipped)        exit_cell="not profiled" ;;
                "build failed") exit_cell="\`-g\` build failed" ;;
                *)              exit_cell=${cg_rc[i]} ;;
            esac
            fewer="n/a"
            if [[ -n ${cg_ir[0]} && -n ${cg_ir[i]} ]]; then
                fewer=$(ratio "${cg_ir[0]}" "${cg_ir[i]}")
            fi
            link="n/a"
            if [[ -n ${cg_file[i]} && -f ${cg_file[i]} ]]; then
                name=$(basename "${cg_file[i]}")
                link="[\`$name\`](<$cg_rel/$name>)"
            fi
            echo "| ${labels[i]} | $exit_cell | $(cell "${cg_time[i]}") | $(cell "$(commas "${cg_ir[i]}")") | $fewer | $link |"
        done
        echo
        echo "- Callgrind counts executed instructions (Ir), not time. Each level was rebuilt with its flags plus \`-g\` for profiling; the timed binaries above have no \`-g\`."
        echo "- Ir vs none is the \`none\` level's instruction count divided by this level's (above 1x means fewer instructions)."
        echo "- Profiled program: \`./$bin_name${cg_args_str:+ $cg_args_str}\`${cg_args_str:+ (arguments from EVAL_CALLGRIND_ARGS, so counts are not from the same run as the timings)}."
        if [[ $mode == -omp ]]; then
            echo "- Callgrind runs the threads one at a time, so Ir is the sum over all threads."
        fi
        if [[ $mode == -cuda ]]; then
            echo "- Callgrind only sees host (CPU) code; work done on the GPU does not appear in the counts."
        fi
        echo "- Open a raw profile with \`callgrind_annotate --auto=no <file>\` or \`kcachegrind <file>\`."
    fi
    if (( nsys )); then
        echo
        echo "## Nsight Systems profile"
        echo
        if [[ $mode == -cuda ]]; then
            echo "| Level | Profile exit | Profile time (s) | GPU kernel time (ms) | Kernel launches | GPU memory op time (ms) | CUDA API time (ms) | Report |"
            echo "|---|---:|---:|---:|---:|---:|---:|---|"
        else
            echo "| Level | Profile exit | Profile time (s) | Report |"
            echo "|---|---:|---:|---|"
        fi
        for i in "${!labels[@]}"; do
            exit_cell="not profiled"
            [[ ${ns_status[i]} == ran ]] && exit_cell=${ns_rc[i]}
            link="n/a"
            if [[ -n ${ns_file[i]} && -f ${ns_file[i]} ]]; then
                name=$(basename "${ns_file[i]}")
                link="[\`$name\`](<$ns_rel/$name>)"
            fi
            if [[ $mode == -cuda ]]; then
                echo "| ${labels[i]} | $exit_cell | $(cell "${ns_time[i]}") | $(cell "${ns_kern_ms[i]}") | $(cell "${ns_kern_n[i]}") | $(cell "${ns_mem_ms[i]}") | $(cell "${ns_api_ms[i]}") | $link |"
            else
                echo "| ${labels[i]} | $exit_cell | $(cell "${ns_time[i]}") | $link |"
            fi
        done
        echo
        echo "- Nsight Systems profiled the same binaries as the timed runs, in a separate run tracing \`$ns_trace\`. Profile time includes nsys startup and writing the report file."
        if [[ $mode == -cuda ]]; then
            echo "- GPU kernel and memory op times are measured on the GPU. CUDA API time is CPU time spent inside CUDA calls, which includes waiting for the GPU. n/a means none were recorded."
        fi
        if [[ $mode == -omp ]]; then
            echo "- GCC's OpenMP runtime lacks the tool interface (OMPT) that nsys uses to trace OpenMP, so with g++ there is usually no OpenMP summary. Thread creation and waits still appear under OS runtime calls."
        fi
        if (( ns_cpu_off )); then
            echo "- This system does not allow CPU sampling or context-switch tracing (\`kernel.perf_event_paranoid\` = $(cat /proc/sys/kernel/perf_event_paranoid 2>/dev/null || echo '?')), so the reports have no CPU samples or thread scheduling data. Lowering it, e.g. \`sudo sysctl kernel.perf_event_paranoid=2\`, usually enables them; \`nsys status --environment\` shows what is available."
        fi
        echo "- Summaries with no data are left out. Open a report with \`nsys-ui <file>\` for the timeline, or \`nsys stats <file>\` for the full summaries."
    fi
    echo
    echo "## Detailed results"
    for i in "${!labels[@]}"; do
        echo
        echo "### ${labels[i]}"
        echo
        echo "\`\`\`bash"
        echo "${shown_cmd[i]}"
        echo "\`\`\`"
        echo
        if (( compile_rc[i] != 0 )); then
            echo "Compilation failed (exit ${compile_rc[i]}) after ${compile_time[i]} s."
        else
            echo "Compiled in ${compile_time[i]} s. Run exited with code ${run_rc[i]} after ${wall_time[i]} s."
        fi
        if [[ -n ${compile_log[i]} ]]; then
            echo
            echo "Compiler messages:"
            echo
            echo "\`\`\`text"
            echo "${compile_log[i]}"
            echo "\`\`\`"
        fi
        if (( compile_rc[i] == 0 )); then
            echo
            echo "Program output:"
            echo
            echo "\`\`\`text"
            echo "${run_out[i]}"
            echo "\`\`\`"
        fi
        if [[ ${cg_status[i]} != skipped ]]; then
            echo
            echo "Callgrind profile:"
            echo
            echo "\`\`\`bash"
            echo "${cg_cmd[i]}"
            echo "valgrind --tool=callgrind ./$bin_name${cg_args_str:+ $cg_args_str}"
            echo "\`\`\`"
            echo
            if [[ ${cg_status[i]} == "build failed" ]]; then
                echo "The \`-g\` build failed, so this level was not profiled."
            else
                echo "Exited with code ${cg_rc[i]} after ${cg_time[i]} s; $(cell "$(commas "${cg_ir[i]}")") instructions executed."
                echo
                if [[ -n ${cg_table[i]} ]]; then
                    echo "Top functions by self cost (instructions in the function's own body). Inclusive also counts the functions it calls."
                    echo
                    echo "${cg_table[i]}"
                else
                    echo "No profile data was written."
                fi
                if (( cg_rc[i] != 0 )) && [[ -n ${cg_log[i]} ]]; then
                    echo
                    echo "Valgrind messages (last 20 lines):"
                    echo
                    echo "\`\`\`text"
                    echo "${cg_log[i]}"
                    echo "\`\`\`"
                fi
            fi
        fi
        if [[ ${ns_status[i]} == ran ]]; then
            echo
            echo "Nsight Systems profile:"
            echo
            echo "\`\`\`bash"
            echo "nsys profile --trace=$ns_trace ./$bin_name"
            echo "\`\`\`"
            echo
            echo "Exited with code ${ns_rc[i]} after ${ns_time[i]} s."
            echo
            if [[ -n ${ns_detail[i]} ]]; then
                echo "${ns_detail[i]}"
            else
                echo "No summary data was recorded."
            fi
            if (( ns_rc[i] != 0 )) && [[ -n ${ns_log[i]} ]]; then
                echo
                echo "nsys messages (last 20 lines):"
                echo
                echo "\`\`\`text"
                echo "${ns_log[i]}"
                echo "\`\`\`"
            fi
        fi
    done
} > "$report"

echo "Report written to $report" >&2
